{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "powerday",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "powerday.work", "custom_domain": true }]
}
