{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "power-chat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "routes": [{ "pattern": "chat.powerday.work", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "power-chat",
      "database_id": "ee568fee-a696-44f5-97b4-ec36978233a5",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_URL": "https://chat.powerday.work",
    "MAIL_FROM": "sign-in@powerday.work",
    "ALLOWLIST": [],
    "AI_GATEWAY_NAME": "power-chat",
    "USAGE_LIMITS": { "default": { "period": "day", "tokens": 100000 }, "overrides": {} },
    "CATALOG": {
      "providers": [{ "id": "cloudflare", "kind": "workers-ai", "label": "Cloudflare" }],
      "models": [
        {
          "id": "glm-4.7-flash",
          "provider": "cloudflare",
          "upstreamId": "@cf/zai-org/glm-4.7-flash",
          "label": "GLM 4.7 Flash",
          "status": "enabled",
          "capabilities": { "tools": true, "vision": false, "reasoning": true },
          "contextWindow": 131072,
          "price": "glm-4.7-flash",
        },
        {
          "id": "gpt-oss-120b",
          "provider": "cloudflare",
          "upstreamId": "@cf/openai/gpt-oss-120b",
          "label": "GPT OSS 120B",
          "status": "enabled",
          "capabilities": { "tools": true, "vision": false, "reasoning": true },
          "contextWindow": 128000,
          "price": "gpt-oss-120b",
        },
      ],
    },
  },
}
