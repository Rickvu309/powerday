{
  "name": "powerday",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node tooling/oxlint-plugin-powerday/lint-tree.js",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "pnpm test:unit && pnpm test:tooling",
    "test:unit": "vitest run",
    "test:tooling": "node scripts/tooling-tests.mjs",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "oxc-parser": "^0.157.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  }
}
